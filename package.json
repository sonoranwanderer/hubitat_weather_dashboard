{
  "name": "ecowitt-weather-hubitat-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "./tests/run-all.sh",
    "build": "npm run build:hubitat",
    "build:hubitat": "node ./esbuild.hubitat.config.mjs",
    "postbuild:hubitat": "node ./build/verify-hubitat-bundle.mjs",
    "build:watch": "node ./esbuild.hubitat.config.mjs --watch",
    "build:release": "node ./esbuild.hubitat.config.mjs --minify",
    "clean": "bash ./build/clean.sh",
    "verify:hubitat": "node ./build/verify-hubitat-bundle.mjs"
  },
  "devDependencies": {
    "esbuild": "file:vendor/esbuild-stub"
  }
}
